                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {},
                    "exec": [
                      "const testCaseId = pm.variables.get(\"testCaseId\");\r",
                      "const expectedStatus = Number(\r",
                      "    pm.variables.get(\"expectedStatus\")\r",
                      ");\r",
                      "\r",
                      "pm.test(`${testCaseId} - Status code is ${expectedStatus}`, () => {\r",
                      "    pm.response.to.have.status(expectedStatus);\r",
                      "});\r",
                      "\r",
                      "pm.test(`${testCaseId} - Response is JSON`, () => {\r",
                      "    pm.expect(\r",
                      "        pm.response.headers.get(\"Content-Type\")\r",
                      "    ).to.include(\"application/json\");\r",
                      "});\r",
                      "\r",
                      "let body;\r",
                      "\r",
                      "try {\r",
                      "    body = pm.response.json();\r",
                      "} catch (error) {\r",
                      "    pm.test(`${testCaseId} - Response body is valid JSON`, () => {\r",
                      "        pm.expect.fail(\"Response body is not valid JSON\");\r",
                      "    });\r",
                      "    return;\r",
                      "}\r",
                      "\r",
                      "const errorSchema = {\r",
                      "    type: \"object\",\r",
                      "    required: [\r",
                      "        \"success\",\r",
                      "        \"error\"\r",
                      "    ],\r",
                      "    properties: {\r",
                      "        success: {\r",
                      "            type: \"boolean\"\r",
                      "        },\r",
                      "        error: {\r",
                      "            type: \"object\",\r",
                      "            required: [\r",
                      "                \"code\",\r",
                      "                \"message\"\r",
                      "            ],\r",
                      "            properties: {\r",
                      "                code: {\r",
                      "                    type: \"string\"\r",
                      "                },\r",
                      "                message: {\r",
                      "                    type: \"string\"\r",
                      "                }\r",
                      "            }\r",
                      "        }\r",
                      "    }\r",
                      "};\r",
                      "\r",
                      "pm.test(`${testCaseId} - Error schema is valid`, () => {\r",
                      "    pm.response.to.have.jsonSchema(errorSchema);\r",
                      "});\r",
                      "\r",
                      "pm.test(`${testCaseId} - Success is false`, () => {\r",
                      "    pm.expect(body.success).to.eql(false);\r",
                      "});\r",
                      "\r",
                      "pm.test(`${testCaseId} - Error code is returned`, () => {\r",
                      "    pm.expect(body.error.code)\r",
                      "        .to.be.a(\"string\")\r",
                      "        .and.not.empty;\r",
                      "});\r",
                      "\r",
                      "pm.test(`${testCaseId} - Error message is returned`, () => {\r",
                      "    pm.expect(body.error.message)\r",
                      "        .to.be.a(\"string\")\r",
                      "        .and.not.empty;\r",
                      "});"
                    ]
