            {
              "name": "password",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const testCaseId = pm.iterationData.get(\"testCaseId\");\r",
                      "const grantType = pm.iterationData.get(\"grant_type\");\r",
                      "const username = pm.iterationData.get(\"username\");\r",
                      "const password = pm.iterationData.get(\"password\");\r",
                      "const clientId = pm.iterationData.get(\"client_id\");\r",
                      "const clientSecret = pm.iterationData.get(\"client_secret\");\r",
                      "const expectedStatus = Number(pm.iterationData.get(\"expectedStatus\"));\r",
                      "\r",
                      "pm.variables.set(\"testCaseId\", \"AUTH-023\");\r",
                      "pm.variables.set(\"expectedStatus\", 200);\r",
                      "\r",
                      "pm.variables.set(\"testCaseId\", testCaseId);\r",
                      "pm.variables.set(\"expectedStatus\", expectedStatus);\r",
                      "\r",
                      "const body = {\r",
                      "    grant_type: grantType,\r",
                      "    client_id: clientId,\r",
                      "    client_secret: clientSecret\r",
                      "};\r",
                      "\r",
                      "// username\r",
                      "if (username !== \"__MISSING__\") {\r",
                      "    body.username = username;\r",
                      "}\r",
                      "\r",
                      "if (password !== \"__MISSING__\") {\r",
                      "    body.password = password;\r",
                      "}\r",
                      "\r",
                      "pm.variables.set(\r",
                      "    \"requestBody\",\r",
                      "    JSON.stringify(body)\r",
                      ");\r",
                      "\r",
                      "console.log(\"Test Case:\", testCaseId);\r",
                      "console.log(\"Expected Status:\", expectedStatus);\r",
                      "console.log(\"Request Body:\", body);"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const testCaseId = pm.variables.get(\"testCaseId\");\r",
                      "const expectedStatus = Number(pm.variables.get(\"expectedStatus\"));\r",
                      "\r",
                      "const body = pm.response.json();\r",
                      "\r",
                      "pm.test(`${testCaseId} - Status code is ${expectedStatus}`, () => {\r",
                      "    pm.response.to.have.status(expectedStatus);\r",
                      "});\r",
                      "\r",
                      "pm.test(`${testCaseId} - Response is JSON`, () => {\r",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
                      "        .to.include(\"application/json\");\r",
                      "});\r",
                      "\r",
                      "if (expectedStatus === 200) {\r",
                      "\r",
                      "    const successSchema = {\r",
                      "        type: \"object\",\r",
                      "        required: [\r",
                      "            \"access_token\",\r",
                      "            \"token_type\",\r",
                      "            \"expires_in\",\r",
                      "            \"scope\"\r",
                      "        ],\r",
                      "        properties: {\r",
                      "            access_token: { type: \"string\" },\r",
                      "            token_type: { type: \"string\" },\r",
                      "            expires_in: { type: \"number\" },\r",
                      "            refresh_token: { type: \"string\" },\r",
                      "            scope: { type: \"string\" },\r",
                      "            create_At: { type: \"number\" }\r",
                      "        }\r",
                      "    };\r",
                      "\r",
                      "    pm.test(`${testCaseId} - Success schema is valid`, () => {\r",
                      "        pm.response.to.have.jsonSchema(successSchema);\r",
                      "    });\r",
                      "\r",
                      "    pm.test(`${testCaseId} - Access token is returned`, () => {\r",
                      "        pm.expect(body.access_token)\r",
                      "            .to.be.a(\"string\")\r",
                      "            .and.not.empty;\r",
                      "    });\r",
                      "\r",
                      "    pm.test(`${testCaseId} - Token type is Bearer`, () => {\r",
                      "        pm.expect(body.token_type).to.eql(\"Bearer\");\r",
                      "    });\r",
                      "\r",
                      "    pm.test(`${testCaseId} - Token expires in 3600 seconds`, () => {\r",
                      "        pm.expect(body.expires_in).to.eql(3600);\r",
                      "    });\r",
                      "}\r",
                      "\r",
                      "if (expectedStatus === 401) {\r",
                      "\r",
                      "    const errorSchema = {\r",
                      "        type: \"object\",\r",
                      "        required: [\r",
                      "            \"success\",\r",
                      "            \"error\"\r",
                      "        ],\r",
                      "        properties: {\r",
                      "            success: {\r",
                      "                type: \"boolean\"\r",
                      "            },\r",
                      "            error: {\r",
                      "                type: \"object\",\r",
                      "                required: [\r",
                      "                    \"code\",\r",
                      "                    \"message\"\r",
                      "                ],\r",
                      "                properties: {\r",
                      "                    code: { type: \"string\" },\r",
                      "                    message: { type: \"string\" }\r",
                      "                }\r",
                      "            }\r",
                      "        }\r",
                      "    };\r",
                      "\r",
                      "    pm.test(`${testCaseId} - Error schema is valid`, () => {\r",
                      "        pm.response.to.have.jsonSchema(errorSchema);\r",
                      "    });\r",
                      "\r",
                      "    pm.test(`${testCaseId} - Success is false`, () => {\r",
                      "        pm.expect(body.success).to.eql(false);\r",
                      "    });\r",
                      "\r",
                      "    pm.test(`${testCaseId} - Error code is returned`, () => {\r",
                      "        pm.expect(body.error.code)\r",
                      "            .to.be.a(\"string\")\r",
                      "            .and.not.empty;\r",
                      "    });\r",
                      "\r",
                      "    pm.test(`${testCaseId} - Error message is returned`, () => {\r",
                      "        pm.expect(body.error.message)\r",
                      "            .to.be.a(\"string\")\r",
                      "            .and.not.empty;\r",
                      "    });\r",
                      "}\r",
                      "\r",
                      "// get refresh token from password\r",
                      "if (body.refresh_token) {\r",
                      "    pm.environment.set(\"REFRESH_TOKEN\", body.refresh_token);\r",
                      "\r",
                      "    console.log(\r",
                      "        \"Saved REFRESH_TOKEN:\",\r",
                      "        body.refresh_token\r",
                      "    );\r",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
