{
  "name": "bill-payment-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:repeat": "playwright test --repeat-each=2",
    "test:api": "playwright test tests/auth/api tests/users/api tests/protocol/api",
    "test:auth": "playwright test tests/auth/api",
    "test:auth:me": "playwright test tests/auth/api/get-user.spec.ts",
    "test:auth:client": "playwright test tests/auth/api/oauth-client.spec.ts",
    "test:auth:password": "playwright test tests/auth/api/oauth-password.spec.ts",
    "test:auth:refresh": "playwright test tests/auth/api/oauth-refresh.spec.ts",
    "test:auth:validation": "playwright test tests/auth/api/oauth-validation.spec.ts",
    "test:user": "playwright test tests/users/api",
    "test:user:create": "playwright test tests/users/api/create-user.spec.ts",
    "test:user:delete": "playwright test tests/users/api/delete-user.spec.ts",
    "test:user:list": "playwright test tests/users/api/get-users.spec.ts",
    "test:user:getById": "playwright test tests/users/api/get-userById.spec.ts",
    "test:user:patch": "playwright test tests/users/api/patch-user.spec.ts",
    "test:user:update": "playwright test tests/users/api/update-user.spec.ts",
    "test:protocol": "playwright test tests/protocol/api",
    "test:billers": "playwright test tests/billers",
    "test:bills": "playwright test tests/bills",
    "test:payments": "playwright test tests/payments",
    "test:e2e": "playwright test tests/e2e",
    "test:jobs": "playwright test tests/jobs",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:security": "playwright test --grep @security",
    "test:validation": "playwright test --grep @validation",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "report:html": "playwright show-report",
    "report:allure": "allure serve allure-results",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "report:allure:build": "npm run report:allure:generate && npm run report:allure:open",
    "typecheck": "tsc --noEmit",
    "clean:allure": "rimraf allure-results allure-report",
    "pretest": "npm run clean:allure"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  }
}
